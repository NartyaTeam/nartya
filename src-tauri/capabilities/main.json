{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Fenêtre principale seulement : ni la fenêtre captcha ni une page tierce n'appellent ces commandes.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-open-external",
    "allow-app-quit",
    "allow-app-focus",
    "allow-hub-is-managed",
    "allow-hub-get-info",
    "allow-hub-open",
    "allow-get-version",
    "allow-get-machine-id",
    "allow-get-anime4k-capabilities",
    "allow-get-auth-redirect-url",
    "allow-get-captcha-token",
    "allow-session-get",
    "allow-session-set",
    "allow-session-remove",
    "allow-resolve-stream",
    "allow-downloads-list",
    "allow-downloads-start",
    "allow-downloads-cancel",
    "allow-downloads-cancel-season",
    "allow-downloads-remove",
    "allow-downloads-set-max-concurrent",
    "allow-downloads-local-url",
    "allow-downloads-get-dir",
    "allow-downloads-choose-dir",
    "allow-downloads-open-dir"
  ]
}
