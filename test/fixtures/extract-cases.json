{
 "_doc": "Cas communs à src/shared (JS, test/shared-extract.test.mjs) et au cœur Rust (stream/extract.rs). Modifier un comportement = modifier ce fichier, les deux implémentations doivent suivre.",
 "recipe": {
  "sources": {
   "jw": {
    "domains": [
     "jw.test"
    ],
    "strategy": "jw-sources",
    "rejectPattern": "sendvid\\.com"
   },
   "og": {
    "domains": [
     "og.test"
    ],
    "strategy": "meta-og",
    "mediaPattern": "https?://videos\\d+\\.og\\.test/[^\"'\\s<>]+\\.mp4"
   },
   "ps": {
    "domains": [
     "ps.test"
    ],
    "strategy": "player-src",
    "mediaBase": "https://media.ps.test"
   },
   "ps2": {
    "domains": [
     "ps2.test"
    ],
    "strategy": "player-src"
   },
   "hj": {
    "domains": [
     "hj.test"
    ],
    "strategy": "hls-json"
   },
   "pk": {
    "domains": [
     "pk.test"
    ],
    "strategy": "packed-jw",
    "exclusive": true
   },
   "sl": {
    "domains": [
     "sl.test"
    ],
    "strategy": "split-link"
   }
  }
 },
