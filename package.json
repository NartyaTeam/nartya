{
  "name": "nartya",
  "version": "1.31.1",
  "description": "Application de streaming d'anime",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:dev": "cross-env NODE_ENV=development node api/src/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "dev:web": "node scripts/dev.mjs web",
    "dev:web:local": "concurrently -k -n api,web -c magenta,cyan \"npm run api:dev\" \"vite\"",
    "dev:web:public": "vite",
    "electron:dev": "node scripts/dev.mjs electron",
    "electron:dev:local": "concurrently -k -n api,vite,electron -c magenta,cyan,yellow \"npm run api:dev\" \"vite\" \"wait-on -t 60000 http-get://localhost:3000/health http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:dev:public": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on -t 60000 http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "lint": "eslint .",
    "test:unit": "node --test test/audio-track.test.mjs test/proxy-range.test.mjs test/video-providers.test.mjs test/stream-anonymization.test.mjs test/version-gate.test.mjs test/hls-detection.test.mjs test/quality-levels.test.mjs test/download-recovery.test.mjs test/session-guards.test.mjs test/changelog.test.mjs test/android-release-manifest.test.mjs test/ios-release-manifest.test.mjs test/shared-session-permissions.test.mjs",
    "test:providers:live": "node test/video-providers-live.mjs",
    "test:providers:electron": "electron test/video-providers-electron-smoke.mjs",
    "test:providers:ui": "node test/video-providers-ui-smoke.mjs",
    "test:cast:fake": "node test/cast-fake-receiver.mjs",
    "test:android": "node scripts/run-android-gradle.mjs testDebugUnitTest",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "android:sync": "npm run build && cap sync android",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:test": "swift test --package-path ios/NartyaNative",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && node scripts/run-android-gradle.mjs assembleDebug",
    "android:release": "npm run android:sync && node scripts/run-android-gradle.mjs assembleRelease",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux --x64 --arm64"
  },
  "keywords": [
    "anime",
    "nartya",
    "streaming",
    "electron"
  ],
  "author": {
    "name": "NartyaTeam",
    "email": "contact@nartya.app"
  },
  "license": "ISC",
  "homepage": "https://nartya.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NartyaTeam/nartya.git"
  },
  "bugs": {
    "url": "https://github.com/NartyaTeam/nartya/issues"
  },
  "dependencies": {
    "castv2-client": "^1.2.0",
    "discord-rpc": "^4.0.1",
    "dns-packet": "^5.6.1",
    "electron-store": "^11.0.2",
    "ffmpeg-static": "^5.2.0",
    "multicast-dns": "^7.2.5",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.39.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@supabase/supabase-js": "^2.112.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "anime4k-webgpu": "^1.0.0",
    "artplayer": "^5.3.0",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.559.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.0.5",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^7.3.6",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.9"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "protobufjs": "^7.6.3",
    "uuid": "^11.1.1",
    "fast-uri": "^3.1.6",
    "browserslist": "^4.28.7",
    "@xmldom/xmldom": "^0.8.15"
  },
  "build": {
    "appId": "com.nartya.app",
    "productName": "Nartya",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://nartya.app/dl/anime",
        "channel": "latest"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/shared/**/*",
      "src/config/instance.js",
      "package.json",
      "!node_modules/**/*/{CHANGELOG.md,README.md,README,readme.md}",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "**/castv2/**/*",
      "**/ffmpeg-static/**/*"
    ],
    "npmRebuild": false,
    "protocols": [
      {
        "name": "Nartya",
        "schemes": [
          "nartya"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win.${ext}",
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nartya",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "icon": "public/icon.icns",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "icon": "public/icon.png",
      "category": "AudioVideo",
      "maintainer": "NartyaTeam <contact@nartya.app>"
    }
  }
}
